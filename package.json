{
  "name": "zpevnak",
  "description": "Zpěvňák: the campfire songbook. Verified ChordPro songs, playlists, offline on any device.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node src/server/main.ts",
    "db:up": "docker compose up -d --wait db",
    "migrate": "node src/server/db/migrate.ts latest",
    "migrate:rollback": "node src/server/db/migrate.ts rollback",
    "seed": "node src/server/db/seed.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "yarn lint:tsc && yarn lint:eslint && yarn lint:knip && yarn lint:prettier",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:knip": "knip",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write .",
    "ux:probe": "node tests/ux-walk/probe.ts",
    "test:guard": "node .claude/hooks/test-guard.js",
    "set-role": "node src/server/cli/set-role.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.25.2",
    "@trpc/react-query": "^11.25.2",
    "@trpc/server": "^11.25.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "idb": "^8.0.4",
    "knex": "^3.3.0",
    "minisearch": "^7.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "imports": {
    "#shared/*": "./src/shared/*",
    "#server/*": "./src/server/*",
    "#client/*": "./src/client/*",
    "#tests/*": "./tests/*"
  }
}
